# Copy to deploy/vm/config.env (git-ignored) and edit. No secrets belong in this file.
# Every value can also be given as an environment variable for one run.

# Where to deploy (used for ssh only; your ~/.ssh/config can add keys and ports).
VM_HOST=relay.ownspace.in
VM_USER=ubuntu

# The VM's CPU: auto (asks the VM with `uname -m`), amd64 or arm64.
VM_ARCH=auto

# Folder in the VM user's home where the bundle is unpacked.
REMOTE_DIR=owntally-deploy

# Iroh relay version to download. A checksum is built in for v1.4.1 on amd64 only;
# for anything else, download the file once, check it by hand, and set its SHA-256 here.
IROH_VERSION=v1.4.1
#IROH_SHA256=

# Only for the first run on a fresh VM (certificate expiry notices).
#CERTBOT_EMAIL=you@example.org

# The public names, if they ever change.
RELAY_HOST=relay.ownspace.in
SITE_HOST=joinowntally.ownspace.in
