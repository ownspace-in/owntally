<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <!-- Only to sync with the other members of a group, phone to phone (owner decision L5, 8 Nov 2026). NetworkUseGuardTest keeps every other part of the app off the network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Nearby (same-room sync), asked for only when the person opens the Nearby screen and taps Continue. Android 11 and 12 call the permission to
      find Bluetooth devices "location"; from Android 13 it is not needed. OwnTally does not read the location.
    -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="31" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" tools:targetApi="31" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" tools:targetApi="33" />

    <!--
      The background sync job (decision B1, M7) is AndroidX WorkManager, which adds WAKE_LOCK, RECEIVE_BOOT_COMPLETED and ACCESS_NETWORK_STATE (all normal
      permissions: no question is asked). The app never runs foreground work, so the permission and the service for it are taken out again.
      ManifestRulesTest checks the merged manifest, not only this file.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <application
        android:name=".OwnTallyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher"
        android:label="OwnTally"
        android:supportsRtl="true"
        android:theme="@style/Theme.OwnTally">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              The invite link (M9, decision A1): https://joinowntally.ownspace.in/j#<code>, claimed as an Android App Link. It is verified against
              https://joinowntally.ownspace.in/.well-known/assetlinks.json (made from the signing certificate: site/README.md); until then Android
              opens the link in the browser, where the page shows the code. The exact path and nothing broader; ManifestRulesTest keeps it so.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="joinowntally.ownspace.in" android:path="/j" />
            </intent-filter>
        </activity>
        <service android:name="androidx.work.impl.foreground.SystemForegroundService" tools:node="remove" />
    </application>

</manifest>
